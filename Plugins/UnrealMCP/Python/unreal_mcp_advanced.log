 with various architectural styles.","inputSchema":{"properties":{"height":{"default":10,"title":"Height","type":"integer"},"base_size":{"default":4,"title":"Base Size","type":"integer"},"block_size":{"default":100.0,"title":"Block Size","type":"number"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"name_prefix":{"default":"TowerBlock","title":"Name Prefix","type":"string"},"mesh":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Mesh","type":"string"},"tower_style":{"default":"cylindrical","title":"Tower Style","type":"string"}},"title":"create_towerArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_towerOutput","type":"object"}},{"name":"create_staircase","description":"Create a staircase from cubes.","inputSchema":{"properties":{"steps":{"default":5,"title":"Steps","type":"integer"},"step_size":{"default":[100.0,100.0,50.0],"items":{"type":"number"},"title":"Step Size","type":"array"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"name_prefix":{"default":"Stair","title":"Name Prefix","type":"string"},"mesh":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Mesh","type":"string"}},"title":"create_staircaseArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_staircaseOutput","type":"object"}},{"name":"construct_house","description":"Construct a realistic house with architectural details and multiple rooms.","inputSchema":{"properties":{"width":{"default":1200,"title":"Width","type":"integer"},"depth":{"default":1000,"title":"Depth","type":"integer"},"height":{"default":600,"title":"Height","type":"integer"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"name_prefix":{"default":"Ho