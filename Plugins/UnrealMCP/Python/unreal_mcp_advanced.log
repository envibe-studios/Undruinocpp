use","title":"Name Prefix","type":"string"},"mesh":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Mesh","type":"string"},"house_style":{"default":"modern","title":"House Style","type":"string"}},"title":"construct_houseArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"construct_houseOutput","type":"object"}},{"name":"construct_mansion","description":"\\n    Construct a magnificent mansion with multiple wings, grand rooms, gardens,\\n    fountains, and luxury features perfect for dramatic TikTok reveals.\\n    ","inputSchema":{"properties":{"mansion_scale":{"default":"large","title":"Mansion Scale","type":"string"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"name_prefix":{"default":"Mansion","title":"Name Prefix","type":"string"}},"title":"construct_mansionArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"construct_mansionOutput","type":"object"}},{"name":"create_arch","description":"Create a simple arch using cubes in a semicircle.","inputSchema":{"properties":{"radius":{"default":300.0,"title":"Radius","type":"number"},"segments":{"default":6,"title":"Segments","type":"integer"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"name_prefix":{"default":"ArchBlock","title":"Name Prefix","type":"string"},"mesh":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Mesh","type":"string"}},"title":"create_archArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_archOutput","type":"object"}},{"name":"spawn_physics_blueprint_actor","description":"\\n    Quickly spawn a single actor with physics, color, and a specific mesh.\\n\\n    This is the primary function for creating simple objects with physics properties.\\n    It handles creating a temporary Blueprint, setting up the mesh, color, and physics,\\n    and then spawns the actor in the world. It\'s ideal for quickly adding\\n    dynamic objects to the scene without needing to manually create Blueprints.\\n    \\n    Args:\\n        color: Optional color as [R, G, B] or [R, G, B, A] where values are 0.0-1.0.\\n               If [R, G, B] is provided, alpha will be set to 1.0 automatically.\\n    ","inputSchema":{"properties":{"name":{"title":"Name","type":"string"},"mesh_path":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Mesh Path","type":"string"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"mass":{"default":1.0,"title":"Mass","type":"number"},"simulate_physics":{"default":true,"title":"Simulate Physics","type":"boolean"},"gravity_enabled":{"default":true,"title":"Gravity Enabled","type":"boolean"},"color":{"default":null,"items":{"type":"number"},"title":"Color","type":"array"},"scale":{"default":[1.0,1.0,1.0],"items":{"type":"number"},"title":"Scale","type":"array"}},"required":["name"],"title":"spawn_physics_blueprint_actorArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"spawn_physics_blueprint_actorOutput","type":"object"}},{"name":"create_maze","description":"Create a proper solvable maze with entrance, exit, and guaranteed path using recursive backtracking algorithm.","inputSchema":{"properties":{"rows":{"default":8,"title":"Rows","type":"integer"},"cols":{"default":8,"title":"Cols","type":"integer"},"cell_size":{"default":300.0,"title":"Cell Size","type":"number"},"wall_height":{"default":3,"title":"Wall Height","type":"integer"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"}},"title":"create_mazeArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_mazeOutput","type":"object"}},{"name":"get_available_materials","description":"Get a list of available materials in the project that can be applied to objects.","inputSchema":{"properties":{"search_path":{"default":"/Game/","title":"Search Path","type":"string"},"include_engine_materials":{"default":true,"title":"Include Engine Materials","type":"boolean"}},"title":"get_available_materialsArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"get_available_materialsOutput","type":"object"}},{"name":"apply_material_to_actor","description":"Apply a specific material to an actor in the level.","inputSchema":{"properties":{"actor_name":{"title":"Actor Name","type":"string"},"material_path":{"title":"Material Path","type":"string"},"material_slot":{"default":0,"title":"Material Slot","type":"integer"}},"required":["actor_name","material_path"],"title":"apply_material_to_actorArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"apply_material_to_actorOutput","type":"object"}},{"name":"apply_material_to_blueprint","description":"Apply a specific material to a component in a Blueprint.","inputSchema":{"properties":{"blueprint_name":{"title":"Blueprint Name","type":"string"},"component_name":{"title":"Component Name","type":"string"},"material_path":{"title":"Material Path","type":"string"},"material_slot":{"default":0,"title":"Material Slot","type":"integer"}},"required":["blueprint_name","component_name","material_path"],"title":"apply_material_to_blueprintArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"apply_material_to_blueprintOutput","type":"object"}},{"name":"get_actor_material_info","description":"Get information about the materials currently applied to an actor.","inputSchema":{"properties":{"actor_name":{"title":"Actor Name","type":"string"}},"required":["actor_name"],"title":"get_actor_material_infoArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"get_actor_material_infoOutput","type":"object"}},{"name":"set_mesh_material_color","description":"Set material color on a mesh component using the proven color system.","inputSchema":{"properties":{"blueprint_name":{"title":"Blueprint Name","type":"string"},"component_name":{"title":"Component Name","type":"string"},"color":{"items":{"type":"number"},"title":"Color","type":"array"},"material_path":{"default":"/Engine/BasicShapes/BasicShapeMaterial","title":"Material Path","type":"string"},"parameter_name":{"default":"BaseColor","title":"Parameter Name","type":"string"},"material_slot":{"default":0,"title":"Material Slot","type":"integer"}},"required":["blueprint_name","component_name","color"],"title":"set_mesh_material_colorArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"set_mesh_material_colorOutput","type":"object"}},{"name":"create_town","description":"Create a full dynamic town with buildings, streets, infrastructure, and vehicles.","inputSchema":{"properties":{"town_size":{"default":"medium","title":"Town Size","type":"string"},"building_density":{"default":0.7,"title":"Building Density","type":"number"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"name_prefix":{"default":"Town","title":"Name Prefix","type":"string"},"include_infrastructure":{"default":true,"title":"Include Infrastructure","type":"boolean"},"architectural_style":{"default":"mixed","title":"Architectural Style","type":"string"}},"title":"create_townArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_townOutput","type":"object"}},{"name":"create_castle_fortress","description":"\\n    Create a massive castle fortress with walls, towers, courtyards, throne room,\\n    and surrounding village. Perfect for dramatic TikTok reveals showing\\n    the scale and detail of a complete medieval fortress.\\n    ","inputSchema":{"properties":{"castle_size":{"default":"large","title":"Castle Size","type":"string"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"name_prefix":{"default":"Castle","title":"Name Prefix","type":"string"},"include_siege_weapons":{"default":true,"title":"Include Siege Weapons","type":"boolean"},"include_village":{"default":true,"title":"Include Village","type":"boolean"},"architectural_style":{"default":"medieval","title":"Architectural Style","type":"string"}},"title":"create_castle_fortressArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_castle_fortressOutput","type":"object"}},{"name":"create_suspension_bridge","description":"\\n    Build a suspension bridge with towers, deck, cables, and suspenders.\\n    \\n    Creates a realistic suspension bridge with parabolic main cables, vertical\\n    suspenders, twin towers, and a multi-lane deck. Perfect for dramatic reveals\\n    showing engineering marvels.\\n    \\n    Args:\\n        span_length: Total span between towers\\n        deck_width: Width of the bridge deck\\n        tower_height: Height of support towers\\n        cable_sag_ratio: Sag as fraction of span (0.1-0.15 typical)\\n        module_size: Resolution for segments (affects actor count)\\n        location: Center point of the bridge\\n        orientation: \\"x\\" or \\"y\\" for bridge direction\\n        name_prefix: Prefix for all spawned actors\\n        deck_mesh: Mesh for deck segments\\n        tower_mesh: Mesh for tower components\\n        cable_mesh: Mesh for cable segments\\n        suspender_mesh: Mesh for vertical suspenders\\n        dry_run: If True, calculate metrics without spawning\\n    \\n    Returns:\\n        Dictionary with success status, spawned actors, and performance metrics\\n    ","inputSchema":{"properties":{"span_length":{"default":6000.0,"title":"Span Length","type":"number"},"deck_width":{"default":800.0,"title":"Deck Width","type":"number"},"tower_height":{"default":4000.0,"title":"Tower Height","type":"number"},"cable_sag_ratio":{"default":0.12,"title":"Cable Sag Ratio","type":"number"},"module_size":{"default":200.0,"title":"Module Size","type":"number"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"orientation":{"default":"x","title":"Orientation","type":"string"},"name_prefix":{"default":"Bridge","title":"Name Prefix","type":"string"},"deck_mesh":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Deck Mesh","type":"string"},"tower_mesh":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Tower Mesh","type":"string"},"cable_mesh":{"default":"/Engine/BasicShapes/Cylinder.Cylinder","title":"Cable Mesh","type":"string"},"suspender_mesh":{"default":"/Engine/BasicShapes/Cylinder.Cylinder","title":"Suspender Mesh","type":"string"},"dry_run":{"default":false,"title":"Dry Run","type":"boolean"}},"title":"create_suspension_bridgeArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_suspension_bridgeOutput","type":"object"}},{"name":"create_aqueduct","description":"\\n    Build a multi-tier Roman-style aqueduct with arches and water channel.\\n    \\n    Creates a majestic aqueduct with repeating arches, support piers, and\\n    a water channel deck. Each tier has progressively smaller piers for\\n    realistic tapering. Perfect for showing ancient engineering.\\n    \\n    Args:\\n        arches: Number of arches per tier\\n        arch_radius: Radius of each arch\\n        pier_width: Width of support piers\\n        tiers: Number of vertical tiers (1-3 recommended)\\n        deck_width: Width of the water channel\\n        module_size: Resolution for segments (affects actor count)\\n        location: Starting point of the aqueduct\\n        orientation: \\"x\\" or \\"y\\" for aqueduct direction\\n        name_prefix: Prefix for all spawned actors\\n        arch_mesh: Mesh for arch segments (cylinder)\\n        pier_mesh: Mesh for support piers\\n        deck_mesh: Mesh for deck and walls\\n        dry_run: If True, calculate metrics without spawning\\n    \\n    Returns:\\n        Dictionary with success status, spawned actors, and performance metrics\\n    ","inputSchema":{"properties":{"arches":{"default":18,"title":"Arches","type":"integer"},"arch_radius":{"default":600.0,"title":"Arch Radius","type":"number"},"pier_width":{"default":200.0,"title":"Pier Width","type":"number"},"tiers":{"default":2,"title":"Tiers","type":"integer"},"deck_width":{"default":600.0,"title":"Deck Width","type":"number"},"module_size":{"default":200.0,"title":"Module Size","type":"number"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"orientation":{"default":"x","title":"Orientation","type":"string"},"name_prefix":{"default":"Aqueduct","title":"Name Prefix","type":"string"},"arch_mesh":{"default":"/Engine/BasicShapes/Cylinder.Cylinder","title":"Arch Mesh","type":"string"},"pier_mesh":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Pier Mesh","type":"string"},"deck_mesh":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Deck Mesh","type":"string"},"dry_run":{"default":false,"title":"Dry Run","type":"boolean"}},"title":"create_aqueductArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_aqueductOutput","type":"object"}},{"name":"add_node","description":"\\n    Add a node to a Blueprint graph.\\n\\n    Create various types of K2Nodes in a Blueprint\'s event graph or function graph.\\n    Supports 23 node types organized by category.\\n\\n    Args:\\n        blueprint_name: Name of the Blueprint to modify\\n        node_type: Type of node to create. Supported types (23 total):\\n\\n            CONTROL FLOW:\\n                \\"Branch\\" - Conditional execution (if/then/else)\\n                \\"Comparison\\" - Arithmetic/logical operators (==, !=, <, >, AND, OR, etc.)\\n                    \xe2\x84\xb9\xef\xb8\x8f Types can be changed via set_node_property with action=\\"set_pin_type\\"\\n                \\"Switch\\" - Switch on byte/enum value with cases\\n                    \xe2\x84\xb9\xef\xb8\x8f Creates 1 pin at creation; add more via set_node_property with action=\\"add_pin\\"\\n                \\"SwitchEnum\\" - Switch on enum type (auto-generates pins per enum value)\\n                    \xe2\x84\xb9\xef\xb8\x8f Creates pins based on enum; change enum via set_node_property with action=\\"set_enum_type\\"\\n                \\"SwitchInteger\\" - Switch on integer value with cases\\n                    \xe2\x84\xb9\xef\xb8\x8f Creates 1 pin at creation; add more via set_node_property with action=\\"add_pin\\"\\n                \\"ExecutionSequence\\" - Sequential execution with multiple outputs\\n                    \xe2\x84\xb9\xef\xb8\x8f Creates 1 pin at creation; add/remove via set_node_property (add_pin/remove_pin)\\n\\n            DATA:\\n                \\"VariableGet\\" - Read a variable value (\xe2\x9a\xa0\xef\xb8\x8f variable must exist in Blueprint)\\n                \\"VariableSet\\" - Set a variable value (\xe2\x9a\xa0\xef\xb8\x8f variable must exist and be assignable)\\n                \\"MakeArray\\" - Create array from individual inputs\\n                    \xe2\x84\xb9\xef\xb8\x8f Creates 1 pin at creation; add/remove via set_node_property with action=\\"set_num_elements\\"\\n\\n            CASTING:\\n                \\"DynamicCast\\" - Cast object to specific class (\xe2\x9a\xa0\xef\xb8\x8f handle \\"Cast Failed\\" output)\\n                \\"ClassDynamicCast\\" - Cast class reference to derived class (\xe2\x9a\xa0\xef\xb8\x8f handle failure cases)\\n                \\"CastByteToEnum\\" - Convert byte value to enum (\xe2\x9a\xa0\xef\xb8\x8f byte must be valid enum range)\\n\\n            UTILITY:\\n                \\"Print\\" - Debug output to screen/log (configurable duration and color)\\n                \\"CallFunction\\" - Call any blueprint/engine function (\xe2\x9a\xa0\xef\xb8\x8f function must exist)\\n                \\"Select\\" - Choose between two inputs based on boolean condition\\n                \\"SpawnActor\\" - Spawn actor from class (\xe2\x9a\xa0\xef\xb8\x8f class must derive from Actor)\\n\\n            SPECIALIZED:\\n                \\"Timeline\\" - Animation timeline playback with curve tracks\\n                    \xe2\x9a\xa0\xef\xb8\x8f REQUIRES MANUAL IMPLEMENTATION: Animation curves must be added in editor\\n                \\"GetDataTableRow\\" - Query row from data table (\xe2\x9a\xa0\xef\xb8\x8f DataTable must exist)\\n                \\"AddComponentByClass\\" - Dynamically add component to actor\\n                \\"Self\\" - Reference to current actor/object\\n                \\"Knot\\" - Invisible reroute node (wire organization only)\\n\\n            EVENT:\\n                \\"Event\\" - Blueprint event (specify event_type: BeginPlay, Tick, etc.)\\n                    \xe2\x84\xb9\xef\xb8\x8f Tick events run every frame - be mindful of performance impact\\n\\n        pos_x: X position in graph (default: 0)\\n        pos_y: Y position in graph (default: 0)\\n        message: For Print nodes, the text to print\\n        event_type: For Event nodes, the event name (BeginPlay, Tick, Destroyed, etc.)\\n        variable_name: For Variable nodes, the variable name\\n        target_function: For CallFunction nodes, the function to call\\n        target_blueprint: For CallFunction nodes, optional path to target Blueprint\\n        function_name: Optional name of function graph to add node to (if None, uses EventGraph)\\n\\n    Returns:\\n        Dictionary with success status, node_id, and position\\n\\n    Important Notes:\\n        - Most nodes can have pins modified after creation via set_node_property\\n        - Dynamic pin management: Switch/SwitchEnum/ExecutionSequence/MakeArray support pin operations\\n        - Timeline is the ONLY node requiring manual implementation (curves must be added in editor)\\n    ","inputSchema":{"properties":{"blueprint_name":{"title":"Blueprint Name","type":"string"},"node_type":{"title":"Node Type","type":"string"},"pos_x":{"default":0,"title":"Pos X","type":"number"},"pos_y":{"default":0,"title":"Pos Y","type":"number"},"message":{"default":"","title":"Message","type":"string"},"event_type":{"default":"BeginPlay","title":"Event Type","type":"string"},"variable_name":{"default":"","title":"Variable Name","type":"string"},"target_function":{"default":"","title":"Target Function","type":"string"},"target_blueprint":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Target Blueprint"},"function_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Function Name"}},"required":["blueprint_name","node_type"],"title":"add_nodeArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"add_nodeOutput","type":"object"}},{"name":"connect_nodes","description":"\\n    Connect two nodes in a Blueprint graph.\\n\\n    Links a source pin to a target pin between existing nodes in a Blueprint\'s event graph or function graph.\\n\\n    Args:\\n        blueprint_name: Name of the Blueprint to modify\\n        source_node_id: ID of the source node\\n        source_pin_name: Name of the output pin on the source node\\n        target_node_id: ID of the target node\\n        target_pin_name: Name of the input pin on the target node\\n        function_name: Optional name of function graph (if None, uses EventGraph)\\n\\n    Returns:\\n        Dictionary with success status and connection details\\n    ","inputSchema":{"properties":{"blueprint_name":{"title":"Blueprint Name","type":"string"},"source_node_id":{"title":"Source Node Id","type":"string"},"source_pin_name":{"title":"Source Pin Name","type":"string"},"target_node_id":{"title":"Target Node Id","type":"string"},"target_pin_name":{"title":"Target Pin Name","type":"string"},"function_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Function Name"}},"required":["blueprint_name","source_node_id","source_pin_name","target_node_id","target_pin_name"],"title":"connect_nodesArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"connect_nodesOutput","type":"object"}},{"name":"create_variable","description":"\\n    Create a variable in a Blueprint.\\n\\n    Adds a new variable to a Blueprint with specified type, default value, and properties.\\n\\n    Args:\\n        blueprint_name: Name of the Blueprint to modify\\n        variable_name: Name of the variable to create\\n        variable_type: Type of the variable (\\"bool\\", \\"int\\", \\"float\\", \\"string\\", \\"vector\\", \\"rotator\\")\\n        default_value: Default value for the variable (optional)\\n        is_public: Whether the variable should be public/editable (default: False)\\n        tooltip: Tooltip text for the variable (optional)\\n        category: Category for organizing variables (default: \\"Default\\")\\n\\n    Returns:\\n        Dictionary with success status and variable details\\n    ","inputSchema":{"properties":{"blueprint_name":{"title":"Blueprint Name","type":"string"},"variable_name":{"title":"Variable Name","type":"string"},"variable_type":{"title":"Variable Type","type":"string"},"default_value":{"default":null,"title":"Default Value"},"is_public":{"default":false,"title":"Is Public","type":"boolean"},"tooltip":{"default":"","title":"Tooltip","type":"string"},"category":{"default":"Default","title":"Category","type":"string"}},"required":["blueprint_name","variable_name","variable_type"],"title":"create_variableArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_variableOutput","type":"object"}},{"name":"set_blueprint_variable_properties","description":"\\n    Modify properties of an existing Blueprint variable without deleting it.\\n\\n    Preserves all VariableGet and VariableSet nodes connected to this variable.\\n\\n    Args:\\n        blueprint_name: Name of the Blueprint to modify\\n        variable_name: Name of the variable to modify\\n\\n        var_name: Rename the variable (optional)\\n            \xe2\x9c\x85 PASS - VarDesc->VarName works correctly\\n\\n        var_type: Change variable type (optional)\\n            \xe2\x9c\x85 PASS - VarDesc->VarType works correctly (int\xe2\x86\x92float returns \\"real\\")\\n\\n        is_blueprint_readable: Allow reading in Blueprint (VariableGet) (optional)\\n            \xe2\x9c\x85 PASS - CPF_BlueprintReadOnly flag (inverted logic)\\n\\n        is_blueprint_writable: Allow writing in Blueprint (Set) (optional)\\n            \xe2\x9c\x85 PASS - CPF_BlueprintReadOnly flag (inverted logic)\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        is_public: Visible in Blueprint editor (optional)\\n            \xe2\x9c\x85 PASS - Controls variable visibility\\n\\n        is_editable_in_instance: Modifiable on instances (optional)\\n            \xe2\x9c\x85 PASS - CPF_DisableEditOnInstance flag (inverted logic)\\n\\n        tooltip: Variable description (optional)\\n            \xe2\x9c\x85 PASS - Metadata MD_Tooltip works correctly\\n\\n        category: Variable category (optional)\\n            \xe2\x9c\x85 PASS - Direct property Category works\\n\\n        default_value: New default value (optional)\\n            \xe2\x9c\x85 PASS - Works but get_variable_details() returns empty string\\n\\n        expose_on_spawn: Show in spawn dialog (optional)\\n            \xe2\x9c\x85 PASS - Metadata MD_ExposeOnSpawn works\\n            \xe2\x9a\xa0\xef\xb8\x8f Requires is_editable_in_instance=true to be visible\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        expose_to_cinematics: Expose to cinematics (optional)\\n            \xe2\x9c\x85 PASS - CPF_Interp flag works correctly\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        slider_range_min: UI slider minimum value (optional)\\n            \xe2\x9c\x85 PASS - Metadata MD_UIMin works (string value)\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        slider_range_max: UI slider maximum value (optional)\\n            \xe2\x9c\x85 PASS - Metadata MD_UIMax works (string value)\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        value_range_min: Clamp minimum value (optional)\\n            \xe2\x9c\x85 PASS - Metadata MD_ClampMin works (string value)\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        value_range_max: Clamp maximum value (optional)\\n            \xe2\x9c\x85 PASS - Metadata MD_ClampMax works (string value)\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        units: Display units (optional)\\n            \xe2\x9a\xa0\xef\xb8\x8f PARTIAL - Metadata MD_Units works for value display (e.g., \\"0.0 cm\\")\\n            \xe2\x9d\x8c UI dropdown stays at \\"None\\" (Unreal Editor limitation - dropdown doesn\'t sync with metadata)\\n            \xe2\x9a\xa0\xef\xb8\x8f Use long format: \\"Centimeters\\", \\"Meters\\" (not \\"cm\\", \\"m\\")\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        bitmask: Treat as bitmask (optional)\\n            \xe2\x9c\x85 PASS - Metadata TEXT(\\"Bitmask\\") works correctly\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        bitmask_enum: Bitmask enum type (optional)\\n            \xe2\x9c\x85 PASS - Metadata TEXT(\\"BitmaskEnum\\") works\\n            \xe2\x9a\xa0\xef\xb8\x8f REQUIRES full path format: \\"/Script/ModuleName.EnumName\\"\\n            \xe2\x9d\x8c Short names generate warning and don\'t sync dropdown\\n            \xe2\x9c\x85 Validated enums (use FULL PATHS):\\n                - /Script/UniversalObjectLocator.ELocatorResolveFlags\\n                - /Script/JsonObjectGraph.EJsonStringifyFlags\\n                - /Script/MediaAssets.EMediaAudioCaptureDeviceFilter\\n                - /Script/MediaAssets.EMediaVideoCaptureDeviceFilter\\n                - /Script/MediaAssets.EMediaWebcamCaptureDeviceFilter\\n                - /Script/Engine.EAnimAssetCurveFlags\\n                - /Script/Engine.EHardwareDeviceSupportedFeatures\\n                - /Script/EnhancedInput.EMappingQueryIssue\\n                - /Script/EnhancedInput.ETriggerEvent\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        replication_enabled: Enable network replication (CPF_Net flag) (optional)\\n            \xe2\x9c\x85 PASS - CPF_Net flag works - Changes \\"Replication\\" dropdown (None \xe2\x86\x94 Replicated)\\n            \xe2\x9a\xa0\xef\xb8\x8f NOT returned by get_variable_details()\\n\\n        replication_condition: Network replication condition (ELifetimeCondition 0-7) (optional)\\n            \xe2\x9c\x85 PASS - VarDesc->ReplicationCondition works\\n            \xe2\x9c\x85 Changes \\"Replication Condition\\" dropdown (e.g., None \xe2\x86\x92 Initial Only)\\n            \xe2\x9a\xa0\xef\xb8\x8f Values: 0=None, 1=InitialOnly, 2=OwnerOnly, 3=SkipOwner, 4=SimulatedOnly, 5=AutonomousOnly, 6=SimulatedOrPhysics, 7=InitialOrOwner\\n            \xe2\x9c\x85 Returned by get_variable_details() as \\"replication\\"\\n\\n        is_private: Set variable as private (optional)\\n            \xe2\x9d\x8c UNRESOLVED - Property flag/metadata not yet identified\\n            \xe2\x9a\xa0\xef\xb8\x8f Attempted CPF_NativeAccessSpecifierPrivate flag and MD_AllowPrivateAccess metadata - neither work\\n            \xe2\x9a\xa0\xef\xb8\x8f The property that controls \\"Priv\xc3\xa9\\" (Private) checkbox remains unknown\\n            \xe2\x9a\xa0\xef\xb8\x8f Parameter exists but has no effect on UI - do NOT use until resolved\\n\\n    Returns:\\n        Dictionary with success status and updated properties\\n    ","inputSchema":{"properties":{"blueprint_name":{"title":"Blueprint Name","type":"string"},"variable_name":{"title":"Variable Name","type":"string"},"var_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Var Name"},"var_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Var Type"},"is_blueprint_readable":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Is Blueprint Readable"},"is_blueprint_writable":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Is Blueprint Writable"},"is_public":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Is Public"},"is_editable_in_instance":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Is Editable In Instance"},"tooltip":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Tooltip"},"category":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Category"},"default_value":{"default":null,"title":"Default Value"},"expose_on_spawn":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Expose On Spawn"},"expose_to_cinematics":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Expose To Cinematics"},"slider_range_min":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Slider Range Min"},"slider_range_max":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Slider Range Max"},"value_range_min":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Value Range Min"},"value_range_max":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Value Range Max"},"units":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Units"},"bitmask":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Bitmask"},"bitmask_enum":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Bitmask Enum"},"replication_enabled":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Replication Enabled"},"replication_condition":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Replication Condition"},"is_private":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Is Private"}},"required":["blueprint_name","variable_name"],"title":"set_blueprint_variable_propertiesArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"set_blueprint_variable_propertiesOutput","type":"object"}},{"name":"add_event_node","description":"\\n    Add an event node to a Blueprint graph.\\n\\n    Create specialized event nodes (ReceiveBeginPlay, ReceiveTick, etc.)\\n    in a Blueprint\'s event graph at specified positions.\\n\\n    Args:\\n        blueprint_name: Name of the Blueprint to modify\\n        event_name: Name of the event (e.g., \\"ReceiveBeginPlay\\", \\"ReceiveTick\\", \\"ReceiveDestroyed\\")\\n        pos_x: X position in graph (default: 0)\\n        pos_y: Y position in graph (default: 0)\\n\\n    Returns:\\n        Dictionary with success status, node_id, event_name, and position\\n    ","inputSchema":{"properties":{"blueprint_name":{"title":"Blueprint Name","type":"string"},"event_name":{"title":"Event Name","type":"string"},"pos_x":{"default":0,"title":"Pos X","type":"number"},"pos_y":{"default":0,"title":"Pos Y","type":"number"}},"required":["blueprint_name","event_name"],"title":"add_event_nodeArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"add_event_nodeOutput","type":"object"}},{"name":"delete_node","description":"\\n    Delete a node from a Blueprint graph.\\n\\n    Removes a node and all its connections from either the EventGraph\\n    or a specific function graph.\\n\\n    Args:\\n        blueprint_name: Name of the Blueprint to modify\\n        node_id: ID of the node to delete (NodeGuid or node name)\\n        function_name: Name of function graph (optional, defaults to EventGraph)\\n\\n    Returns:\\n        Dictionary with success status and deleted_node_id\\n    ","inputSchema":{"properties":{"blueprint_name":{"title":"Blueprint Name","type":"string"},"node_id":{"title":"Node Id","type":"string"},"function_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Function Name"}},"required":["blueprint_name","node_id"],"title":"delete_nodeArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"delete_nodeOutput","type":"object"}},{"name":"set_node_property","description":"\\n    Set a property on a Blueprint node or perform semantic node editing.\\n\\n    This function supports both simple property modifications and advanced semantic\\n    node editing operations (pin management, type modifications, reference updates).\\n\\n    Args:\\n        blueprint_name: Name of the Blueprint to modify\\n        node_id: ID of the node to modify\\n        property_name: Name of property to set (legacy mode, used if action not specified)\\n        property_value: Value to set (legacy mode)\\n        function_name: Name of function graph (optional, defaults to EventGraph)\\n        action: Semantic action to perform - can be one of:\\n            Phase 1 (Pin Management):\\n                - \\"add_pin\\": Add a pin to a node (requires pin_type)\\n                - \\"remove_pin\\": Remove a pin from a node (requires pin_name)\\n                - \\"set_enum_type\\": Set enum type on a node (requires enum_type)\\n            Phase 2 (Type Modification):\\n                - \\"set_pin_type\\": Change pin type on comparison nodes (requires pin_name, new_type)\\n                - \\"set_value_type\\": Change value type on select nodes (requires new_type)\\n                - \\"set_cast_target\\": Change cast target type (requires target_type)\\n            Phase 3 (Reference Updates - DESTRUCTIVE):\\n                - \\"set_function_call\\": Change function being called (requires target_function)\\n                - \\"set_event_type\\": Change event type (requires event_type)\\n\\n    Semantic action parameters:\\n        pin_type: Type of pin to add (\\"SwitchCase\\", \\"ExecutionOutput\\", \\"ArrayElement\\", \\"EnumValue\\")\\n        pin_name: Name of pin to remove or modify\\n        enum_type: Full path to enum type (e.g., \\"/Game/Enums/ECardinalDirection\\")\\n        new_type: New type for pin or value (\\"int\\", \\"float\\", \\"string\\", \\"bool\\", \\"vector\\", etc.)\\n        target_type: Target class path for casting\\n        target_function: Name of function to call\\n        target_class: Optional class containing the function\\n        event_type: Event type (e.g., \\"BeginPlay\\", \\"Tick\\", \\"Destroyed\\")\\n\\n    Returns:\\n        Dictionary with success status and details\\n\\n    Supported legacy properties by node type:\\n        - Print nodes: \\"message\\", \\"duration\\", \\"text_color\\"\\n        - Variable nodes: \\"variable_name\\"\\n        - All nodes: \\"pos_x\\", \\"pos_y\\", \\"comment\\"\\n\\n    Examples:\\n        Legacy mode (set simple property):\\n            set_node_property(\\n                blueprint_name=\\"MyActorBlueprint\\",\\n                node_id=\\"K2Node_1234567890\\",\\n                property_name=\\"message\\",\\n                property_value=\\"Hello World!\\"\\n            )\\n\\n        Semantic mode (add pin):\\n            set_node_property(\\n                blueprint_name=\\"MyActorBlueprint\\",\\n                node_id=\\"K2Node_Switch_123\\",\\n                action=\\"add_pin\\",\\n                pin_type=\\"SwitchCase\\"\\n            )\\n\\n        Semantic mode (set enum type):\\n            set_node_property(\\n                blueprint_name=\\"MyActorBlueprint\\",\\n                node_id=\\"K2Node_SwitchEnum_456\\",\\n                action=\\"set_enum_type\\",\\n                enum_type=\\"ECardinalDirection\\"\\n            )\\n\\n        Semantic mode (change function call):\\n            set_node_property(\\n                blueprint_name=\\"MyActorBlueprint\\",\\n                node_id=\\"K2Node_CallFunction_789\\",\\n                action=\\"set_function_call\\",\\n                target_function=\\"BeginPlay\\",\\n                target_class=\\"APawn\\"\\n            )\\n    ","inputSchema":{"properties":{"blueprint_name":{"title":"Blueprint Name","type":"string"},"node_id":{"title":"Node Id","type":"string"},"property_name":{"default":"","title":"Property Name","type":"string"},"property_value":{"default":null,"title":"Property Value"},"function_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Function Name"},"action":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Action"},"pin_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Pin Type"},"pin_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Pin Name"},"enum_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Enum Type"},"new_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"New Type"},"target_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Target Type"},"target_function":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Target Function"},"target_class":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Target Class"},"event_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Event Type"}},"required":["blueprint_name","node_id"],"title":"set_node_propertyArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"set_node_propertyOutput","type":"object"}},{"name":"create_function","description":"\\n    Create a new function in a Blueprint.\\n\\n    Args:\\n        blueprint_name: Name of the Blueprint to modify\\n        function_name: Name for the new function\\n        return_type: Return type of the function (default: \\"void\\")\\n\\n    Returns:\\n        Dictionary with function_name, graph_id or error\\n    ","inputSchema":{"properties":{"blueprint_name":{"title":"Blueprint Name","type":"string"},"function_name":{"title":"Function Name","type":"string"},"return_type":{"default":"void","title":"Return Type","type":"string"}},"required":["blueprint_name","function_name"],"title":"create_functionArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_functionOutput","type":"object"}},{"name":"add_function_input","description":"\\n    Add an input parameter to