ction Name","type":"string"},"include_graph":{"default":true,"title":"Include Graph","type":"boolean"}},"required":["blueprint_path"],"title":"get_blueprint_function_detailsArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"get_blueprint_function_detailsOutput","type":"object"}},{"name":"create_pyramid","description":"Spawn a pyramid made of cube actors.","inputSchema":{"properties":{"base_size":{"default":3,"title":"Base Size","type":"integer"},"block_size":{"default":100.0,"title":"Block Size","type":"number"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"name_prefix":{"default":"PyramidBlock","title":"Name Prefix","type":"string"},"mesh":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Mesh","type":"string"}},"title":"create_pyramidArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_pyramidOutput","type":"object"}},{"name":"create_wall","description":"Create a simple wall from cubes.","inputSchema":{"properties":{"length":{"default":5,"title":"Length","type":"integer"},"height":{"default":2,"title":"Height","type":"integer"},"block_size":{"default":100.0,"title":"Block Size","type":"number"},"location":{"default":[0.0,0.0,0.0],"items":{"type":"number"},"title":"Location","type":"array"},"orientation":{"default":"x","title":"Orientation","type":"string"},"name_prefix":{"default":"WallBlock","title":"Name Prefix","type":"string"},"mesh":{"default":"/Engine/BasicShapes/Cube.Cube","title":"Mesh","type":"string"}},"title":"create_wallArguments","type":"object"},"outputSchema":{"properties":{"result":{"additionalProperties":true,"title":"Result","type":"object"}},"required":["result"],"title":"create_wallOutput","type":"object"}},{"name":"create_tower","description":"Create a realistic tower